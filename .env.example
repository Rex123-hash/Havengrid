# ── Environment integrity ─────────────────────────────────────────────────
# VITE_APP_ENV: development | test | staging | judge | production   (default development)
#   development / test    → local synthetic seed permitted, backend optional
#   staging / judge / prod → VITE_SCENARIO_SOURCE=backend is REQUIRED; a local-seed
#                            build fails at `vite build`, and a synthetic backend
#                            bundle is rejected at runtime (unavailable state).
VITE_APP_ENV=development

# VITE_SCENARIO_SOURCE: local | backend
#   local   — src/data/landingScenario.ts (mirrors the backend's derived values)
#   backend — replay the Sundargarh story on the backend (see backend/README.md)
VITE_SCENARIO_SOURCE=local

# HAVENGRID_MODE: rehearsal | operational
#   rehearsal   — resettable scripted story (synthetic fixtures only)
#   operational — backend reads on page load; automatic replay/mutations disabled
VITE_HAVENGRID_MODE=rehearsal

# Authenticated workspace source is independent from the historical landing story.
# Defaults to api. mock is allowed only in development/test rehearsal.
VITE_WORKSPACE_SOURCE=api
# Empty uses the Vite /api proxy to the local FastAPI process on port 8000.
VITE_API_BASE_URL=
